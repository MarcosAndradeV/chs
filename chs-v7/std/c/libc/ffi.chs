module libc

type cstring ^u8

type char u8

type long i64
type longlong i64
type ulong u64
type ulonglong u64
type schar i8
type short i16
type uint u32
type double f64
type float f32

type size_t  u64
type ssize_t i64
type wchar_t i32

type FILE struct {}
type va_list struct {}
